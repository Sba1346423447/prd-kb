# docker compose 环境变量模板：复制为 .env 并按本机实际情况修改
# （compose 项目目录为 docker/，.env 需放在 docker/ 下）

# 本地模型目录（宿主机绝对路径，挂载进容器；替换为你本机的模型存放路径）
EMBEDDING_MODEL_DIR=/path/to/models/bge-small-zh-v1.5
RERANK_MODEL_DIR=/path/to/models/bge-reranker-v2-m3

# MySQL 配置
DB_PASSWORD=prd_kb_root
DB_NAME=prd_kb

# JWT 签名密钥（生产环境必须改为随机长字符串）
JWT_SECRET=change-me-in-production
